{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service-config",
  "type": "object",
  "required": [
    "name",
    "endpoints"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "sync",
        "async"
      ]
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "url",
        "method"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        }
      }
    }
  }
}