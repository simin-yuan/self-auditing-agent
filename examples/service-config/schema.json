{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service-config",
  "type": "object",
  "required": ["name", "endpoints"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["sync", "async"]
    },
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "method"],
        "properties": {
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE"]
          }
        }
      }
    }
  }
}
